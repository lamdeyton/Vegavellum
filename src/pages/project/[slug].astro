---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getAllProjects, getCategoryById, getSourceLabel, getProjectsByCategory } from '../../lib/data';

export function getStaticPaths() {
  const projects = getAllProjects();
  return projects.map((p) => ({
    params: { slug: p.slug },
    props: { project: p },
  }));
}

const { project } = Astro.props;
const category = getCategoryById(project.category);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const repoUrl = `https://github.com/${project.repo}`;
const sources = Array.isArray(project.sources) ? project.sources : [];

const relatedProjects = getProjectsByCategory(project.category)
  .filter((p) => p.slug !== project.slug)
  .slice(0, 3);

// JSON-LD BreadcrumbList 结构化数据（SEO：帮助搜索引擎理解页面层级）
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: '首页',
      item: `${siteUrl}${base}/`,
    },
    ...(category ? [{
      '@type': 'ListItem',
      position: 2,
      name: category.name,
      item: `${siteUrl}${base}/category/${category.id}/`,
    }] : []),
    {
      '@type': 'ListItem',
      position: category ? 3 : 2,
      name: project.name,
      item: `${siteUrl}${base}/project/${project.slug}/`,
    },
  ],
};

const softwareLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: project.name,
  description: project.description,
  codeRepository: repoUrl,
  ...(project.url ? { url: project.url } : {}),
  ...(project.license ? { license: project.license } : {}),
  ...(project.language ? { programmingLanguage: project.language } : {}),
  ...(category ? { applicationCategory: category.name } : {}),
};
---

<Base title={`${project.name} · Vegavellum`} description={project.description} path={`project/${project.slug}`} jsonLd={[breadcrumbLd, softwareLd]}>
  <article class="detail">
    <nav class="breadcrumb" aria-label="面包屑导航">
      <a href={`${base}/`}>首页</a>
      {category && (
        <>
          <span class="sep" aria-hidden="true">/</span>
          <a href={`${base}/category/${category.id}/`}><span aria-hidden="true">{category.icon}</span> {category.name}</a>
        </>
      )}
    </nav>

    <header class="detail-head">
      <h1>{project.name}</h1>
      <p class="detail-desc">{project.description}</p>
      <div class="detail-actions">
        <a class="btn btn-primary" href={repoUrl} target="_blank" rel="noopener noreferrer">
          GitHub ↗
        </a>
        {project.url && (
          <a class="btn btn-secondary" href={project.url} target="_blank" rel="noopener noreferrer">
            官网 ↗
          </a>
        )}
      </div>
    </header>

    <dl class="info">
      <div>
        <dt>分类</dt>
        <dd>
          {category ? (
            <a href={`${base}/category/${category.id}/`}>
              <span aria-hidden="true">{category.icon}</span> {category.name}
            </a>
          ) : project.category}
        </dd>
      </div>
      {project.license && (
        <div>
          <dt>许可证</dt>
          <dd><span class="badge">{project.license}</span></dd>
        </div>
      )}
      {project.language && (
        <div>
          <dt>主语言</dt>
          <dd>{project.language}</dd>
        </div>
      )}
      <div>
        <dt>收录日期</dt>
        <dd>{project.addedAt}</dd>
      </div>
      {sources.length > 0 && (
        <div>
          <dt>收录来源</dt>
          <dd>{sources.map((s) => getSourceLabel(s)).join('、')}</dd>
        </div>
      )}
    </dl>

    {Array.isArray(project.tags) && project.tags.length > 0 && (
      <section class="tags-section">
        <h2>标签</h2>
        <ul class="tags">
          {project.tags.map((t) => <li>#{t}</li>)}
        </ul>
      </section>
    )}

    {relatedProjects.length > 0 && (
      <section class="related-section">
        <h2>同类项目</h2>
        <div class="related-grid">
          {relatedProjects.map((p) => <ProjectCard project={p} />)}
        </div>
      </section>
    )}
  </article>
</Base>

<style>
  .detail {
    max-width: 860px;
  }

  .breadcrumb {
    font-size: 0.875rem;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.75rem;
  }

  .breadcrumb a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .breadcrumb .sep {
    color: var(--border);
  }

  .detail-head {
    margin: 0 0 1.5rem;
  }

  .detail-head h1 {
    margin: 0 0 0.4rem;
    font-size: 2rem;
  }

  .detail-desc {
    margin: 0;
    color: var(--text-muted);
    font-size: 1.05rem;
  }

  .detail-actions {
    display: flex;
    gap: 0.75rem;
    margin-top: 1rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 0.6rem 1.2rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .btn-primary {
    background: var(--accent);
    color: #fff;
  }

  .btn-primary:hover {
    background: #4c1d95;
  }

  .btn-secondary {
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--border);
  }

  .btn-secondary:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .info {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem 1.5rem;
    margin: 0 0 1.5rem;
  }

  .info div {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.75rem 1rem;
  }

  .info dt {
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-bottom: 0.25rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .info dd {
    margin: 0;
    font-weight: 600;
    word-break: break-word;
  }

  .info a {
    color: var(--text);
    text-decoration: none;
  }

  .info a:hover {
    color: var(--accent);
  }

  .badge {
    display: inline-block;
    background: var(--accent-soft);
    color: var(--accent);
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    font-size: 0.8rem;
  }

  .tags-section h2 {
    font-size: 1.1rem;
    margin: 0 0 0.6rem;
  }

  .tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .tags li {
    background: #f1f1f6;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
  }

  .related-section {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .related-section h2 {
    font-size: 1.1rem;
    margin: 0 0 1rem;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1rem;
  }
</style>
