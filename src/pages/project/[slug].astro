---
import Base from '../../layouts/Base.astro';
import { getAllProjects, getCategoryById } from '../../lib/data';

export function getStaticPaths() {
  const projects = getAllProjects();
  return projects.map((p) => ({
    params: { slug: p.slug },
    props: { project: p },
  }));
}

const { project } = Astro.props;
const category = getCategoryById(project.category);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const repoUrl = `https://github.com/${project.repo}`;
const sources = Array.isArray(project.sources) ? project.sources : [];
---

<Base title={`${project.name} · Vegavellum`} description={project.description}>
  <article class="detail">
    <a class="back" href={`${base}/`}>← 返回首页</a>

    <header class="detail-head">
      <h1>{project.name}</h1>
      <p class="detail-desc">{project.description}</p>
      {category && (
        <a class="cat-chip" href={`${base}/category/${category.id}`}>
          {category.icon} {category.name}
        </a>
      )}
    </header>

    <dl class="info">
      <div>
        <dt>GitHub 仓库</dt>
        <dd>
          <a href={repoUrl} target="_blank" rel="noopener noreferrer">
            {project.repo} ↗
          </a>
        </dd>
      </div>
      {project.url && (
        <div>
          <dt>官网</dt>
          <dd>
            <a href={project.url} target="_blank" rel="noopener noreferrer">
              {project.url} ↗
            </a>
          </dd>
        </div>
      )}
      {project.license && (
        <div>
          <dt>许可证</dt>
          <dd><span class="badge">{project.license}</span></dd>
        </div>
      )}
      {project.language && (
        <div>
          <dt>主语言</dt>
          <dd>{project.language}</dd>
        </div>
      )}
      <div>
        <dt>收录日期</dt>
        <dd>{project.addedAt}</dd>
      </div>
      {sources.length > 0 && (
        <div>
          <dt>收录来源</dt>
          <dd>{sources.join(', ')}</dd>
        </div>
      )}
    </dl>

    {project.tags && project.tags.length > 0 && (
      <section class="tags-section">
        <h2>标签</h2>
        <ul class="tags">
          {project.tags.map((t) => <li>#{t}</li>)}
        </ul>
      </section>
    )}
  </article>
</Base>

<style>
  .detail {
    max-width: 760px;
  }

  .back {
    font-size: 0.875rem;
    text-decoration: none;
    color: var(--text-muted);
  }

  .back:hover {
    color: var(--accent);
  }

  .detail-head {
    margin: 0.75rem 0 1.5rem;
  }

  .detail-head h1 {
    margin: 0 0 0.4rem;
    font-size: 2rem;
  }

  .detail-desc {
    margin: 0 0 0.75rem;
    color: var(--text-muted);
    font-size: 1.05rem;
  }

  .cat-chip {
    display: inline-block;
    text-decoration: none;
    background: var(--accent-soft);
    color: var(--accent);
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .info {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1rem 1.5rem;
    margin: 0 0 1.5rem;
  }

  .info div {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.75rem 1rem;
  }

  .info dt {
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-bottom: 0.25rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .info dd {
    margin: 0;
    font-weight: 600;
    word-break: break-word;
  }

  .badge {
    display: inline-block;
    background: var(--accent-soft);
    color: var(--accent);
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    font-size: 0.8rem;
  }

  .tags-section h2 {
    font-size: 1.1rem;
    margin: 0 0 0.6rem;
  }

  .tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .tags li {
    background: #f1f1f6;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
  }
</style>
