---
import Base from '../layouts/Base.astro';
import CategoryList from '../components/CategoryList.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getAllCategories, getAllProjects } from '../lib/data';

const categories = getAllCategories();
const projects = getAllProjects();

const counts: Record<string, number> = {};
for (const p of projects) {
  counts[p.category] = (counts[p.category] ?? 0) + 1;
}

const stats = {
  projects: projects.length,
  categories: categories.length,
  categoriesWithProjects: Object.values(counts).filter((n) => n > 0).length,
};

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';

const searchIndex = projects.map((p) => ({
  slug: p.slug,
  name: p.name,
  description: p.description,
  tags: p.tags ?? [],
  category: p.category,
}));

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Vegavellum',
  alternateName: '织星卷',
  url: `${siteUrl}${base}/`,
  description: '精选目录式 GitHub 开源项目索引',
  inLanguage: 'zh-CN',
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteUrl}${base}/?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
---

<Base title="Vegavellum · 织星为卷，索引开源" jsonLd={websiteLd}>
  <section class="hero">
    <h1>Vegavellum</h1>
    <p class="slogan">织星为卷，索引开源。</p>
    <p class="slogan-en" lang="en">Weaving the GitHub galaxy onto one scroll.</p>
    <p class="naming">
      Vega — 织女星，编织云锦亦为夏夜最亮导航星；Vellum — 精制羊皮卷。
      将散落于 GitHub 星河中的优质开源项目，精心编织誊抄于一卷珍贵典籍。
    </p>
    <div class="search-box">
      <input
        id="search-input"
        type="search"
        placeholder="搜索项目名称、描述或标签..."
        aria-label="搜索项目"
        autocomplete="off"
      />
    </div>
    <ul class="stats">
      <li class="stat">
        <span class="num">{stats.projects}</span>
        <span class="label">已收录项目</span>
      </li>
      <li class="stat">
        <span class="num">{stats.categoriesWithProjects}</span>
        <span class="label">已覆盖分类</span>
      </li>
      <li class="stat">
        <span class="num">{stats.categories}</span>
        <span class="label">总分类数</span>
      </li>
    </ul>
  </section>

  <section class="categories">
    <h2>分类</h2>
    <CategoryList categories={categories} counts={counts} />
  </section>

  <section class="projects-section" id="projects-section" style="display: none;">
    <h2>搜索结果 <span id="result-count" class="result-count"></span></h2>
    <div id="search-results" class="project-grid"></div>
  </section>
</Base>

<script is:inline>
  const searchIndex = JSON.parse(document.getElementById('search-data').textContent);
  const base = document.getElementById('search-base').textContent;
  const input = document.getElementById('search-input');
  const resultsDiv = document.getElementById('search-results');
  const resultCount = document.getElementById('result-count');
  const projectsSection = document.getElementById('projects-section');

  const params = new URLSearchParams(window.location.search);
  const q = params.get('q');
  if (q) {
    input.value = q;
    doSearch(q);
  }

  let timeout;
  input.addEventListener('input', (e) => {
    clearTimeout(timeout);
    const query = e.target.value;
    timeout = setTimeout(() => doSearch(query), 150);
    if (query) {
      const url = new URL(window.location);
      url.searchParams.set('q', query);
      history.replaceState(null, '', url);
    } else {
      history.replaceState(null, '', window.location.pathname);
    }
  });

  function doSearch(query) {
    const q = query.trim().toLowerCase();
    if (!q) {
      projectsSection.style.display = 'none';
      return;
    }

    const results = searchIndex.filter((p) => {
      return (
        p.name.toLowerCase().includes(q) ||
        p.description.toLowerCase().includes(q) ||
        p.tags.some((t) => t.toLowerCase().includes(q))
      );
    });

    resultCount.textContent = `(${results.length})`;
    resultsDiv.innerHTML = '';

    if (results.length === 0) {
      resultsDiv.innerHTML = '<p class="no-results">未找到匹配的项目，试试其他关键词？</p>';
    } else {
      for (const p of results) {
        const card = document.createElement('article');
        card.className = 'card';
        const tagsHtml = p.tags.length > 0
          ? `<ul class="tags">${p.tags.map((t) => `<li>#${t}</li>`).join('')}</ul>`
          : '';
        card.innerHTML = `
          <h3 class="card-title"><a href="${base}/project/${p.slug}/">${escapeHtml(p.name)}</a></h3>
          <p class="card-desc">${escapeHtml(p.description)}</p>
          ${tagsHtml}
        `;
        resultsDiv.appendChild(card);
      }
    }

    projectsSection.style.display = 'block';
  }

  function escapeHtml(str) {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }
</script>

<script id="search-data" type="application/json" set:html={JSON.stringify(searchIndex).replace(/</g, '\\u003c')}></script>
<script id="search-base" type="text/plain" set:text={base}></script>

<style>
  .hero {
    text-align: center;
    padding: 2rem 0 2.5rem;
  }

  .hero h1 {
    font-size: clamp(2.2rem, 6vw, 3.2rem);
    margin: 0 0 0.5rem;
    letter-spacing: 0.02em;
  }

  .slogan {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--accent);
  }

  .slogan-en {
    margin: 0.2rem 0 1rem;
    font-size: 0.95rem;
    color: var(--text-muted);
    font-style: italic;
  }

  .naming {
    max-width: 640px;
    margin: 0 auto;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .search-box {
    max-width: 520px;
    margin: 1.5rem auto 0;
  }

  .search-box input {
    width: 100%;
    padding: 0.75rem 1rem;
    font-size: 1rem;
    border: 2px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
    color: var(--text);
    transition: border-color 0.15s, box-shadow 0.15s;
  }

  .search-box input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  .stats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: center;
    gap: 2.5rem;
    margin-top: 1.75rem;
    flex-wrap: wrap;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
  }

  .stat .num {
    font-size: 1.8rem;
    font-weight: 800;
    color: var(--accent);
    line-height: 1;
  }

  .stat .label {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .categories {
    margin-top: 1rem;
  }

  .categories h2 {
    margin: 0 0 1rem;
    font-size: 1.3rem;
  }

  .projects-section {
    margin-top: 2.5rem;
  }

  .projects-section h2 {
    margin: 0 0 1rem;
    font-size: 1.3rem;
  }

  .result-count {
    font-size: 0.95rem;
    font-weight: 400;
    color: var(--text-muted);
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }

  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.25rem 1.25rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    transition: transform 0.15s ease, box-shadow 0.15s ease,
      border-color 0.15s ease;
  }

  .card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgba(20, 19, 43, 0.08);
    border-color: #d2d5de;
  }

  .card-title {
    margin: 0;
    font-size: 1.1rem;
  }

  .card-title a {
    color: var(--text);
    text-decoration: none;
  }

  .card-title a:hover {
    color: var(--accent);
  }

  .card-desc {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
    flex: 1;
  }

  .tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .tags li {
    background: #f1f1f6;
    padding: 0.1rem 0.45rem;
    border-radius: 6px;
  }

  .no-results {
    color: var(--text-muted);
    text-align: center;
    padding: 2rem;
  }
</style>
