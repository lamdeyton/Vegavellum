---
import Base from '../layouts/Base.astro';
import CategoryList from '../components/CategoryList.astro';
import { getAllCategories, getAllProjects } from '../lib/data';

const categories = getAllCategories();
const projects = getAllProjects();

const counts: Record<string, number> = {};
for (const p of projects) {
  counts[p.category] = (counts[p.category] ?? 0) + 1;
}

const stats = {
  projects: projects.length,
  categories: categories.length,
  categoriesWithProjects: Object.values(counts).filter((n) => n > 0).length,
};

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';

// JSON-LD WebSite 结构化数据（SEO：声明站点身份，帮助搜索引擎识别品牌名）
// R23 Connection 修复：补齐 R18/R20 未覆盖的首页层
// 不加 SearchAction：站点当前无搜索功能，声明了无法履行会被降权
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Vegavellum',
  alternateName: '织星卷',
  url: `${siteUrl}${base}/`,
  description: '精选目录式 GitHub 开源项目索引',
  inLanguage: 'zh-CN',
};
---

<Base title="Vegavellum · 织星为卷，索引开源" jsonLd={websiteLd}>
  <section class="hero">
    <h1>Vegavellum</h1>
    <p class="slogan">织星为卷，索引开源。</p>
    <p class="slogan-en" lang="en">Weaving the GitHub galaxy onto one scroll.</p>
    <p class="naming">
      Vega — 织女星，编织云锦亦为夏夜最亮导航星；Vellum — 精制羊皮卷。
      将散落于 GitHub 星河中的优质开源项目，精心编织誊抄于一卷珍贵典籍。
    </p>
    <ul class="stats">
      <li class="stat">
        <span class="num">{stats.projects}</span>
        <span class="label">已收录项目</span>
      </li>
      <li class="stat">
        <span class="num">{stats.categoriesWithProjects}</span>
        <span class="label">已覆盖分类</span>
      </li>
      <li class="stat">
        <span class="num">{stats.categories}</span>
        <span class="label">总分类数</span>
      </li>
    </ul>
  </section>

  <section class="categories">
    <h2>分类</h2>
    <CategoryList categories={categories} counts={counts} />
  </section>
</Base>

<style>
  .hero {
    text-align: center;
    padding: 2rem 0 2.5rem;
  }

  .hero h1 {
    font-size: clamp(2.2rem, 6vw, 3.2rem);
    margin: 0 0 0.5rem;
    letter-spacing: 0.02em;
  }

  .slogan {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--accent);
  }

  .slogan-en {
    margin: 0.2rem 0 1rem;
    font-size: 0.95rem;
    color: var(--text-muted);
    font-style: italic;
  }

  .naming {
    max-width: 640px;
    margin: 0 auto;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .stats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: center;
    gap: 2.5rem;
    margin-top: 1.75rem;
    flex-wrap: wrap;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
  }

  .stat .num {
    font-size: 1.8rem;
    font-weight: 800;
    color: var(--accent);
    line-height: 1;
  }

  .stat .label {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .categories {
    margin-top: 1rem;
  }

  .categories h2 {
    margin: 0 0 1rem;
    font-size: 1.3rem;
  }
</style>
