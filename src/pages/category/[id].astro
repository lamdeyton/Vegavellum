---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import {
  getAllCategories,
  getProjectsByCategory,
} from '../../lib/data';

export function getStaticPaths() {
  const categories = getAllCategories();
  return categories.map((c) => ({
    params: { id: c.id },
    props: { category: c },
  }));
}

const { category } = Astro.props;
const projects = getProjectsByCategory(category.id);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';

// JSON-LD BreadcrumbList 结构化数据（SEO：帮助搜索引擎理解页面层级）
// R20 Connection 修复：与 project/[slug].astro 一致，category 页也需 JSON-LD
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: '首页',
      item: `${siteUrl}${base}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: category.name,
      item: `${siteUrl}${base}/category/${category.id}/`,
    },
  ],
};
---

<Base title={`${category.name} · Vegavellum`} description={category.description} path={`category/${category.id}`} jsonLd={breadcrumbLd}>
  <section class="category-head">
    <nav class="breadcrumb" aria-label="面包屑导航">
      <a href={`${base}/`}>首页</a>
      <span class="sep" aria-hidden="true">/</span>
      <span class="current" aria-current="page"><span aria-hidden="true">{category.icon}</span> {category.name}</span>
    </nav>
    <h1>
      <span class="icon" aria-hidden="true">{category.icon}</span>
      {category.name}
      <span class="name-en" lang="en">{category.name_en}</span>
    </h1>
    <p class="desc">{category.description}</p>
  </section>

  {projects.length > 0 ? (
    <section class="grid">
      {projects.map((p) => <ProjectCard project={p} />)}
    </section>
  ) : (
    <div class="empty">
      <p class="empty-title">该分类暂无已收录项目</p>
      <p class="empty-hint">如果你知道优秀的开源项目，欢迎通过 PR 提名收录。</p>
      <a class="empty-cta" href={`${base}/`}>← 浏览其他分类</a>
    </div>
  )}
</Base>

<style>
  .category-head {
    margin-bottom: 1.5rem;
  }

  .breadcrumb {
    font-size: 0.875rem;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.75rem;
  }

  .breadcrumb a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .breadcrumb .sep {
    color: var(--border);
  }

  .breadcrumb .current {
    color: var(--text);
    font-weight: 600;
  }

  .category-head h1 {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin: 0.75rem 0 0.35rem;
    font-size: 1.8rem;
  }

  .icon {
    font-size: 1.6rem;
  }

  .name-en {
    font-size: 1rem;
    color: var(--text-muted);
    font-weight: 400;
  }

  .desc {
    margin: 0;
    color: var(--text-muted);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }

  .empty {
    color: var(--text-muted);
    background: var(--surface);
    border: 1px dashed var(--border);
    border-radius: 12px;
    padding: 2.5rem;
    text-align: center;
  }

  .empty-title {
    margin: 0 0 0.5rem;
    font-size: 1.05rem;
    color: var(--text);
    font-weight: 600;
  }

  .empty-hint {
    margin: 0 0 1.25rem;
    font-size: 0.9rem;
  }

  .empty-cta {
    display: inline-block;
    color: var(--accent);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .empty-cta:hover {
    text-decoration: underline;
  }
</style>
